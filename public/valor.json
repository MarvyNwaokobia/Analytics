{"project":"valor","name":"Valor","asOf":"2026-11-26T11:52:05.000Z","startDate":"2026-06-01","definitions":{"player":"A wallet that created a character (CharacterClaimed on ValorGameRecord) and is currently GoodDollar-whitelisted.","active":"A player who played, bought, earned or sent/received G$ in the window, counted from contract events. Relay and team wallets excluded.","gMoved":"G$ into plus out of Valor contracts, team wallets excluded. Includes duel stakes going in and duel prizes and refunds coming out.","gSpentInApp":"G$ players paid into Valor contracts for something (marketplace, re-arms, pools). Duel stakes are not spending and are counted separately.","rewards":"G$ Valor paid players from its reward pools: gameplay rewards plus season and campaign prizes. Duel prizes and refunds are players' own stakes changing hands, so they are counted separately.","prizes":"Season and referral-campaign payouts, recognised by their on-chain reference (derived from the program id). Prizes paid before a season starts count in all-time totals and are listed on the season, but not toward its targets.","staked":"G$ players put up as duel stakes (Face-Off and wave race share one escrow, so they are counted together).","duelUnsettled":"Stakes not yet paid out or refunded: open challenges and accepted duels that never resolved. Prize plus cut equals both stakes, so this is what remains.","battles":"Every BattleRecorded: campaign fights, duels, each Endless or Seasonal wave cleared and each death, and each finished Gauntlet run.","runs":"Runs started, by mode (AttemptStarted). Endless and Seasonal runs are recorded from 2026-11-23, Gauntlet runs from 2026-08-29. Each run's waves also count as battles.","revenue":"G$ Valor keeps: marketplace sales and resale fees, plus the withdrawal fee (relay-sent transfers into the treasury), plus the duel house cut (stake pair minus the winner's prize).","withdrawFee":"The cut of each in-app withdrawal, sent by the relay to the treasury wallet. G$ sent to the treasury by hand is not counted.","duelCut":"A reward-pool payout counts as a duel win when it equals the winner's share of a stake tier and the winner staked that tier in the previous 30 days. The cut stays in the pool.","offchain":"Groups are not in these contracts (they live in the Valor database)."},"excludedWallets":[{"wallet":"0x222054050310e28a492c3ff4e2f120b936c4b99d","label":"Valor team funding wallet (pool funder)"},{"wallet":"0x65d25f54cf80761b2d018ad10800921fce8303bf","label":"Valor relay (current)"},{"wallet":"0x43a5ba0da132b21bdacfbc4392b72eebaf6f2d82","label":"Valor relay (old)"}],"totals":{"txs":16171,"txsLast7d":236,"txsLast30d":2064,"charactersClaimed":562,"spikeClaimsExcluded":973,"verifiedNow":316,"verifiedOnChainEvent":247,"verifiedLiveOnly":69,"players":562,"wau":62,"mau":105,"activeAnyWalletMau":105,"battles":9313,"runs":15,"runsByMode":{"endless":8,"seasonal":0,"gauntlet":7},"gMoved":3390926,"gSpentInApp":139277,"gSpentMarketplace":137530,"marketplacePurchases":277,"revenue":561005.12,"marketplaceRevenue":137530,"marketplaceRevenueWithdrawn":72640,"withdrawFeeRevenue":423468.12,"withdrawalsCharged":118,"duelCutRevenue":7,"duelStaked":9000,"duelStakes":69,"duelPaidToWinners":1393,"duelWins":7,"duelRefunded":4700,"duelUnsettled":2900,"rewardsPaid":3236556,"rewardsGameplay":906556,"prizesPaid":2330000,"earners":245,"itemsRegistered":33,"verifiedCheckedAt":"2026-11-26T11:52:01.000Z","walletsVerifyChecked":562},"prizePrograms":[{"kind":"season","name":"First Breach","startsAt":"2026-07-26T23:00:00+00:00","endsAt":"2026-07-27T22:59:59+00:00","paidG":500000,"winners":10,"firstPaid":"2026-07-27","lastPaid":"2026-07-27"},{"kind":"season","name":"Second Wave","startsAt":"2026-08-13T23:00:00+00:00","endsAt":"2026-08-16T22:59:59+00:00","paidG":500000,"winners":10,"firstPaid":"2026-08-17","lastPaid":"2026-08-17"},{"kind":"referralCampaign","name":"Launch Week Referral Campaign","startsAt":"2026-08-23T23:00:00+00:00","endsAt":"2026-08-3